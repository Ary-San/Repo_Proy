# Plantilla de las variables de entorno que la aplicacion necesita.
#
# Copiar como .env y rellenar. El .env real NUNCA se commitea: esta en
# .gitignore, y esta plantilla existe justamente para no tener que compartir
# valores reales por chat para saber que variables hacen falta.

# --- Obligatorias -----------------------------------------------------------
# Sin estas dos la aplicacion no arranca, y es a proposito: una clave de firma o
# una contrasena con valor por defecto acaban llegando a produccion sin que
# nadie lo note.

# Clave de firma de los JWT. Minimo 32 caracteres, porque HS256 exige 256 bits.
# Generar una nueva con:  openssl rand -base64 48
# No reutilizar la de otro entorno: quien tenga esta clave puede emitirse un
# token valido para cualquier usuario.
JWT_SECRET=

# Contrasena del usuario de la base de datos.
DB_PASSWORD=

# --- Opcionales -------------------------------------------------------------
# Todas tienen un valor por defecto razonable; se declaran aqui para que se sepa
# que existen.

# Vidas de los tokens, en formato ISO-8601 de duracion.
# El de acceso es corto porque no se puede revocar; el de refresco es largo pero
# vive en la base y si se revoca.
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D

# Origenes permitidos por CORS, separados por coma. No usar "*": con
# credenciales el navegador lo rechaza.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Conexion a la base.
DB_URL=jdbc:postgresql://localhost:5432/checkout
DB_USERNAME=checkout

# Que hace Hibernate con el esquema al arrancar.
# validate es el valor por defecto y el correcto para cualquier entorno
# compartido. En local, mientras el proyecto no tenga migraciones, hace falta
# update para que las tablas se creen solas.
DDL_AUTO=update
